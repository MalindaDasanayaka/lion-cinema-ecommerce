# ==============================================================================
# Environment Configuration Template - Lion Cinema Web Platform
# Copy this file to .env and update the values with your local environment settings.
# ==============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lion_cinema_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Mailer Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password_here

# PayHere Payment Gateway (Sandbox / Production)
PAYHERE_MERCHANT_ID=your_merchant_id_here
PAYHERE_MERCHANT_SECRET=your_merchant_secret_here
PAYHERE_MODE=sandbox
PAYHERE_CURRENCY=LKR
